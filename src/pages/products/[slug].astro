---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetailClient from '../../components/react/ProductDetailClient.tsx';
import { getEntry } from 'astro:content';
import { INDUSTRIES } from '../../data';

const slug = Astro.params.slug;

// Load ONLY this single product (~4KB instead of 18MB)
const entry = await getEntry('products', slug!);

if (!entry) {
  return Astro.redirect('/products');
}

const product = entry.data;

// Prepare lightweight data for client hydration
const industriesLite = INDUSTRIES.map(i => ({ name: i.name, slug: i.slug }));

// Resolve similar products individually (only the ones we need)
const similarSlugs = product.similarProducts || [];
const uniqueSlugs = [...new Set(similarSlugs)].slice(0, 10);

const similarEntries = await Promise.all(
  uniqueSlugs.map(s => getEntry('products', s))
);

const similarProductsResolved = similarEntries
  .filter(Boolean)
  .map(e => ({
    id: e!.data.id,
    name: e!.data.name,
    slug: e!.data.slug,
    cas: e!.data.cas,
    ec: e!.data.ec,
  }));
---

<BaseLayout title={`${product.name} | SoleChem Europe`} description={product.description?.substring(0, 160) || `${product.name} - CAS ${product.cas}. Request a quote from SoleChem Europe.`}>
  {/* JSON-LD Structured Data */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.solechem.eu/" },
      { "@type": "ListItem", "position": 2, "name": "Products", "item": "https://www.solechem.eu/products" },
      { "@type": "ListItem", "position": 3, "name": product.category, "item": `https://www.solechem.eu/products?category=${encodeURIComponent(product.category)}` },
      { "@type": "ListItem", "position": 4, "name": product.name, "item": `https://www.solechem.eu/products/${product.slug}` }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "description": product.description?.substring(0, 200),
    "url": `https://www.solechem.eu/products/${product.slug}`,
    "category": product.category,
    "brand": { "@type": "Brand", "name": "SoleChem" },
    "identifier": product.cas,
    "additionalProperty": [
      { "@type": "PropertyValue", "name": "CAS Number", "value": product.cas },
      ...(product.ec && product.ec !== "N/A" ? [{ "@type": "PropertyValue", "name": "EC Number", "value": product.ec }] : []),
      ...(product.formula ? [{ "@type": "PropertyValue", "name": "Chemical Formula", "value": product.formula }] : []),
      ...(product.mw && product.mw !== "N/A" ? [{ "@type": "PropertyValue", "name": "Molecular Weight", "value": product.mw }] : [])
    ],
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "seller": { "@type": "Organization", "name": "SoleChem" }
    }
  })} />

  <ProductDetailClient client:load product={product} industries={industriesLite} similarProducts={similarProductsResolved} />
</BaseLayout>
